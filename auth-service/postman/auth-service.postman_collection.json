{
  "item": [
    {
      "name": "1 Registrera patient",
      "request": {
        "url": "{{baseUrl}}/api/auth/register",
        "method": "POST",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"role\":\"PATIENT\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Skapad\", () => pm.response.to.have.status(201));",
              "const profile = pm.response.json();",
              "pm.test(\"Profilens fält\", () => { pm.expect(profile).to.have.all.keys(\"id\", \"username\", \"role\"); });",
              "pm.test(\"Rätt användare\", () => { pm.expect(profile.username).to.eql(pm.collectionVariables.get(\"username\")); pm.expect(profile.role).to.eql(\"PATIENT\"); });",
              "pm.collectionVariables.set(\"userId\", profile.id);"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        },
        {
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"username\", \"api.patient.\" + pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.set(\"password\", \"TestPassword123!\");"
            ],
            "type": "text/javascript"
          },
          "listen": "prerequest"
        }
      ]
    },
    {
      "name": "2 Logga in",
      "request": {
        "url": "{{baseUrl}}/api/auth/login",
        "method": "POST",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Inloggning lyckas\", () => pm.response.to.have.status(200));",
              "const profile = pm.response.json();",
              "pm.test(\"Profilens fält\", () => { pm.expect(profile).to.have.all.keys(\"id\", \"username\", \"role\"); });",
              "pm.test(\"Rätt användare\", () => { pm.expect(profile.username).to.eql(pm.collectionVariables.get(\"username\")); pm.expect(profile.role).to.eql(\"PATIENT\"); });",
              "pm.test(\"Samma id\", () => pm.expect(String(profile.id)).to.eql(String(pm.collectionVariables.get(\"userId\"))));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "3 Hämta registrerad användare",
      "request": {
        "url": "{{baseUrl}}/api/auth/users/{{userId}}",
        "method": "GET",
        "header": []
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Användaren finns\", () => pm.response.to.have.status(200));",
              "const profile = pm.response.json();",
              "pm.test(\"Profilens fält\", () => { pm.expect(profile).to.have.all.keys(\"id\", \"username\", \"role\"); });",
              "pm.test(\"Rätt användare\", () => { pm.expect(profile.username).to.eql(pm.collectionVariables.get(\"username\")); pm.expect(profile.role).to.eql(\"PATIENT\"); });"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "4 Avvisa dubblett",
      "request": {
        "url": "{{baseUrl}}/api/auth/register",
        "method": "POST",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\",\"role\":\"PATIENT\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Upptaget användarnamn\", () => pm.response.to.have.status(409));",
              "pm.test(\"Felmeddelande\", () => pm.expect(pm.response.json().message).to.be.a(\"string\"));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "5 Avvisa fel lösenord",
      "request": {
        "url": "{{baseUrl}}/api/auth/login",
        "method": "POST",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"username\":\"{{username}}\",\"password\":\"WrongPassword123!\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Felaktig inloggning\", () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "6 Avvisa ogiltig roll",
      "request": {
        "url": "{{baseUrl}}/api/auth/register",
        "method": "POST",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\"username\":\"invalid.role\",\"password\":\"{{password}}\",\"role\":\"ADMIN\"}"
        }
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Ogiltig roll\", () => pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    },
    {
      "name": "7 Saknad användare",
      "request": {
        "url": "{{baseUrl}}/api/auth/users/9223372036854775807",
        "method": "GET",
        "header": []
      },
      "event": [
        {
          "script": {
            "exec": [
              "pm.test(\"Användaren saknas\", () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          },
          "listen": "test"
        }
      ]
    }
  ],
  "variable": [
    {
      "value": "http://localhost:8081",
      "key": "baseUrl"
    },
    {
      "value": "",
      "key": "username"
    },
    {
      "value": "TestPassword123!",
      "key": "password"
    },
    {
      "value": "",
      "key": "userId"
    }
  ],
  "info": {
    "name": "Lab 2 - Auth - registrera, logga in och hämta",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Kör samlingen i ordning med Collection Runner. Den skapar ett unikt fiktivt konto per körning."
  }
}
