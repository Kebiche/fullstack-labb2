{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "Lab 2 - bilder - hela patientflödet",
    "description": "Kör i ordning. Starta auth-, journal- och bildtjänsten. Välj fixtures/patient-demo.png i uppladdningsanropet eller använd postman som working directory i Newman."
  },
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Läkare skapad\", () => pm.response.to.have.status(201));",
              "pm.test(\"Läkarroll\", () => pm.expect(pm.response.json().role).to.eql(\"DOCTOR\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"doctorUsername\", \"image.doctor.\" + suffix);",
              "pm.collectionVariables.set(\"patientUsername\", \"image.patient.\" + suffix);"
            ]
          }
        }
      ],
      "name": "1 Registrera fiktiv läkare",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{doctorUsername}}\",\"password\":\"{{password}}\",\"role\":\"DOCTOR\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{authUrl}}/api/auth/register"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Patientkonto skapat\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"patientUserId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "name": "2 Registrera fiktiv patient",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{patientUsername}}\",\"password\":\"{{password}}\",\"role\":\"PATIENT\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{authUrl}}/api/auth/register"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Patientprofil skapad\", () => pm.response.to.have.status(200));",
              "pm.test(\"Rätt konto\", () => pm.expect(String(pm.response.json().userId)).to.eql(String(pm.collectionVariables.get(\"patientUserId\"))));",
              "pm.collectionVariables.set(\"patientId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "name": "3 Skapa patientprofil i journal-tjänsten",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Fiktiv bildtestpatient\",\"ssNumber\":\"{{patientUsername}}\",\"userId\":{{patientUserId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{journalUrl}}/api/patients"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Bild skapad\", () => pm.response.to.have.status(201));",
              "const image = pm.response.json();",
              "pm.test(\"Version och PNG\", () => { pm.expect(image.version).to.eql(1); pm.expect(image.contentType).to.eql(\"image/png\"); });",
              "pm.test(\"Rätt patient\", () => pm.expect(String(image.patientId)).to.eql(String(pm.collectionVariables.get(\"patientId\"))));",
              "pm.collectionVariables.set(\"imageId\", image.id);"
            ]
          }
        }
      ],
      "name": "4 Ladda upp bild som läkare",
      "request": {
        "body": {
          "formdata": [
            {
              "value": "{{patientId}}",
              "key": "patientId",
              "type": "text"
            },
            {
              "src": "fixtures/patient-demo.png",
              "key": "image",
              "type": "file"
            }
          ],
          "mode": "formdata"
        },
        "method": "POST",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Lista hämtad\", () => pm.response.to.have.status(200));",
              "pm.test(\"Bilden finns\", () => pm.expect(pm.response.json().some(image => image.id === pm.collectionVariables.get(\"imageId\"))).to.eql(true));"
            ]
          }
        }
      ],
      "name": "5 Lista patientens bilder",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images?patientId={{patientId}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Bild hämtad\", () => pm.response.to.have.status(200));",
              "pm.test(\"PNG-bild\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"));",
              "pm.test(\"Version 1\", () => pm.expect(pm.response.headers.get(\"X-Image-Version\")).to.eql(\"1\"));"
            ]
          }
        }
      ],
      "name": "6 Hämta originalbild",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ändringar sparade\", () => pm.response.to.have.status(200));",
              "pm.test(\"Version 2\", () => pm.expect(pm.response.json().version).to.eql(2));"
            ]
          }
        }
      ],
      "name": "7 Lägg till text, linje och rektangel",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"annotations\":[{\"type\":\"text\",\"x\":15,\"y\":10,\"text\":\"Fiktivt fynd\",\"fontSize\":20,\"color\":\"#ff0000\"},{\"type\":\"line\",\"x1\":20,\"y1\":110,\"x2\":150,\"y2\":110,\"color\":\"#0000ff\",\"strokeWidth\":4},{\"type\":\"rectangle\",\"x\":230,\"y\":20,\"width\":60,\"height\":40,\"color\":\"#00ff00\",\"strokeWidth\":4}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}/annotate"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Annoterad bild hämtad\", () => pm.response.to.have.status(200));",
              "pm.test(\"Version 2\", () => pm.expect(pm.response.headers.get(\"X-Image-Version\")).to.eql(\"2\"));"
            ]
          }
        }
      ],
      "name": "8 Hämta annoterad bild",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Versionskonflikt\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "name": "9 Avvisa gammal bildversion",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"version\":1,\"annotations\":[{\"type\":\"text\",\"x\":15,\"y\":10,\"text\":\"Fiktivt fynd\",\"fontSize\":20,\"color\":\"#ff0000\"},{\"type\":\"line\",\"x1\":20,\"y1\":110,\"x2\":150,\"y2\":110,\"color\":\"#0000ff\",\"strokeWidth\":4},{\"type\":\"rectangle\",\"x\":230,\"y\":20,\"width\":60,\"height\":40,\"color\":\"#00ff00\",\"strokeWidth\":4}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}/annotate"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Patienten får läsa\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "name": "10 Patienten läser sin bild",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{patientUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Patienten nekas ändring\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "name": "11 Patienten får inte annotera",
      "request": {
        "body": {
          "mode": "raw",
          "raw": "{\"version\":1,\"annotations\":[{\"type\":\"text\",\"x\":15,\"y\":10,\"text\":\"Fiktivt fynd\",\"fontSize\":20,\"color\":\"#ff0000\"},{\"type\":\"line\",\"x1\":20,\"y1\":110,\"x2\":150,\"y2\":110,\"color\":\"#0000ff\",\"strokeWidth\":4},{\"type\":\"rectangle\",\"x\":230,\"y\":20,\"width\":60,\"height\":40,\"color\":\"#00ff00\",\"strokeWidth\":4}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "basic": [
            {
              "value": "{{patientUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}/annotate"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Fel inloggning\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "name": "12 Avvisa fel lösenord",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "WrongPassword123!",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/{{imageId}}"
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Bilden saknas\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "name": "13 Okänt bild-id",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "basic": [
            {
              "value": "{{doctorUsername}}",
              "key": "username",
              "type": "string"
            },
            {
              "value": "{{password}}",
              "key": "password",
              "type": "string"
            }
          ],
          "type": "basic"
        },
        "url": "{{imageUrl}}/api/images/00000000-0000-4000-8000-000000000000"
      }
    }
  ],
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "journalUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "imageUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "password",
      "value": "TestPassword123!"
    },
    {
      "key": "doctorUsername",
      "value": ""
    },
    {
      "key": "patientUsername",
      "value": ""
    },
    {
      "key": "patientUserId",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    }
  ]
}
